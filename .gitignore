# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
*.local
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
# The hosted instance's template. Same rule as above: the example is committed
# so the server has something to copy, the filled-in .env never is.
!.env.prod.example

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local Claude settings (personal, per-machine)
.claude/settings.local.json

# Docker / data
postgres-data/
ollama-data/

# Local SQLite dev database
*.db
helix.db

# Standalone Ouroboros clone (own git repo + 256MB venv + real .env); the
# engine Helix uses is vendored at backend/engine/ouroboros/.
/Ouroboros/

# Session logs / working notes (internal process chatter, not product docs).
# BATON-RAJNISH.md, BATON-MANSOOR.md, and baton-2.md are curated handoff docs
# and stay tracked; only the raw .txt session transcripts are ignored.
baton*.txt
*-baton.txt
dump*.txt
*-dump.txt

# Impeccable: per-developer overrides (hook consent). Shared config.json is tracked.
.impeccable/config.local.json

# Written only when an e2e run fails — a diagnostic, not a deliverable.
docs/screenshots/99-failure.png
