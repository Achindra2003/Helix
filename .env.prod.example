# Configuration for the hosted instance. Used by docker-compose.prod.yml.
#
#   cp .env.prod.example .env      # on the server, then fill in every value
#
# Compose reads `.env` from the directory it runs in. This file is the
# template; the real one is never committed. Five values below have no
# default and the stack refuses to start without them — that is deliberate,
# and it is better than an instance that comes up on a guessable secret.

# --- The image ---------------------------------------------------------
# Which published version this instance runs. Set it to an exact tag, never
# to `latest`: an instance that changes version on the next restart is one
# nobody can debug afterwards, because "what was running?" has no answer.
HELIX_VERSION=v0.9.0-rc1

# --- The domain --------------------------------------------------------
# Caddy requests a Let's Encrypt certificate for exactly this name, so its DNS
# A record must already point at this instance before the stack starts.
HELIX_DOMAIN=helix.example.com

# --- Secrets -----------------------------------------------------------
# Generate both, once, on the server. Do not reuse a value from anywhere:
#
#   openssl rand -base64 32
#
# JWT_SECRET signs login tokens AND derives the encryption of saved provider
# keys. Changing it later logs everyone out and invalidates those keys, so
# treat it as permanent for the life of the instance and back it up with the
# database — a restore without it is a restore nobody can log in to.
JWT_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=helix
POSTGRES_DB=helix

# --- Schema ------------------------------------------------------------
# false on a hosted instance, on purpose. The app can create its own tables at
# boot (`create_all`), which is what makes the self-hosted one-command install
# work — but here the schema is applied as an explicit, reviewable step with
# `alembic upgrade head` (see the runbook). CI checks on every push that the
# two produce the same schema on real Postgres, so this is a choice about who
# controls the timing, not about which one is correct.
DB_AUTO_CREATE=false

# --- The model ---------------------------------------------------------
# `stub` echoes the prompt back and needs no key — every screen is explorable,
# which makes it the honest default for a first boot you want to verify rather
# than demo. Switch to `groq` once the instance is confirmed healthy.
LLM_PROVIDER=stub
GROQ_API_KEY=
TAVILY_API_KEY=
